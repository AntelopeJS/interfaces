    "@antelopejs/interface-dms-mailing": "dms-mailing",
    "@antelopejs/interface-dms-marketing": "dms-marketing",
    "@antelopejs/interface-dms-media": "dms-media",
    "@antelopejs/interface-dms-saas": "dms-saas",
    "@antelopejs/interface-email": "email",
    "@antelopejs/interface-file-storage": "file-storage",
    "@antelopejs/interface-mongodb": "mongodb",
    "@antelopejs/interface-redis": "redis",
    "@antelopejs/interface-redis-scheduler": "redis_scheduler",
    "@antelopejs/interface-rethinkdb": "rethinkdb",
