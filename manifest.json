  "templates": [
    {
      "name": "Blank Typescript",
      "repository": "https://github.com/AntelopeJS/template-blank-typescript.git",
      "branch": "main"
    },
    {
      "name": "Module Typescript",
      "repository": "https://github.com/AntelopeJS/template-module-typescript.git",
      "branch": "main"
    },
    {
      "name": "DMS Module Typescript",
      "description": "Reusable DMS module with a Vue component and a local playground. Requires Node.js 24, pnpm and MongoDB.",
      "repository": "https://github.com/AntelopeJS/template-module-dms.git",
      "branch": "main",
      "packageManager": "pnpm",
      "nextSteps": [
        {
          "command": "pnpm run setup",
          "description": "Install the frontend and generate playground/.env without overwriting an existing one."
        },
        {
          "command": "pnpm services:up",
          "description": "Start MongoDB and Mailpit with Docker Compose, or configure your local services in playground/.env."
        },
        {
          "command": "pnpm dev",
          "description": "Start the playground backend in watch mode."
        },
        {
          "command": "pnpm frontend:dev",
          "description": "In a second terminal, start the dashboard and create the first administrator."
        }
      ]
    },
    {
      "name": "Todo App Typescript",
      "repository": "https://github.com/AntelopeJS/template-todo-typescript.git",
      "branch": "main"
    }
  ],
  "projectTemplates": [
    {
      "name": "DMS Demo",
      "description": "Complete dashboard with all DMS features and a Vue frontend. Requires Node.js 24, pnpm and MongoDB.",
      "repository": "https://github.com/AntelopeJS/template-dms-demo.git",
      "branch": "main",
      "packageManager": "pnpm",
      "nextSteps": [
        {
          "command": "pnpm run setup",
          "description": "Install the frontend and create .env without overwriting an existing one. Start MongoDB and adjust MONGODB_URL if needed."
        },
        {
          "command": "pnpm dev",
          "description": "Install the configured modules and start the DMS backend."
        },
        {
          "command": "pnpm frontend:dev",
          "description": "In a second terminal in this directory, start the dashboard and open the printed URL to create the first administrator."
        }
      ]
    }
  ]
}
